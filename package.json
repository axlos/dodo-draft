{
  "private": true,
  "name": "dodo-draft",
  "version": "0.0.1",
  "author": {
    "email": "ingaxl@gmail.com",
    "name": "Alex Ospina"
  },
  "engines": {
    "node": "16.14.2"
  },
  "scripts": {
    "ng": "ng",
    "start-local": "ng serve -c=development --proxy-config=src/proxy-dev.conf.json",
    "start-prod": "ng serve -c=production --proxy-config=src/proxy.conf.json",
    "build-local": "node --max_old_space_size=6144 ./node_modules/@angular/cli/bin/ng build -c=development --aot",
    "build-prod": "node --max_old_space_size=6144 ./node_modules/@angular/cli/bin/ng build -c=production --aot --extract-licenses=true",
    "watch": "ng build --watch -c=development",
    "test": "ng test",
    "postinstall": "npm run build-prod",
    "start": "node server.js"
  },
  "dependencies": {
    "@angular/animations": "^15.2.0",
    "@angular/cdk": "^15.0.0",
    "@angular/cli": "~15.2.8",
    "@angular/common": "^15.2.0",
    "@angular/compiler": "^15.2.0",
    "@angular/core": "^15.2.0",
    "@angular/forms": "^15.2.0",
    "@angular/platform-browser": "^15.2.0",
    "@angular/platform-browser-dynamic": "^15.2.0",
    "@angular/router": "^15.2.0",
    "@auth0/auth0-angular": "^2.1.0",
    "@nebular/eva-icons": "^11.0.0",
    "@nebular/theme": "^11.0.0",
    "@ngrx/effects": "^15.4.0",
    "@ngrx/store": "^15.4.0",
    "@ngrx/store-devtools": "^15.4.0",
    "@ngx-translate/core": "^14.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "bootstrap": "^5.2.3",
    "eva-icons": "^1.1.3",
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "ngx-dropzone": "^3.1.0",
    "rxjs": "~7.8.0",
    "zone.js": "~0.12.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^15.2.8",
    "@angular/compiler-cli": "^15.2.0",
    "@schematics/angular": "~15.2.8",
    "depcheck": "^1.4.3",
    "typescript": "~4.9.4"
  }
}
